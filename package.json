{
  "name": "emberfall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tools && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "balance": "esbuild tools/balance/cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/emberfall-balance/cli.mjs --log-level=warning && node node_modules/.cache/emberfall-balance/cli.mjs",
    "test": "npm run balance -- check",
    "sprites": "esbuild tools/sprite-sheet/entry.ts --bundle --format=iife --outfile=node_modules/.cache/sprite-sheet/bundle.js --log-level=warning && node tools/sprite-sheet/run.mjs",
    "icons": "node tools/icon/make-icons.mjs",
    "check:pwa": "npm run build && node tools/pwa-check.mjs",
    "check:hover": "npm run build && node tools/hovercard-check.mjs",
    "check:fx": "npm run build && node tools/battle-fx-check.mjs",
    "check:guard": "npm run build && node tools/guard-check.mjs",
    "check:music": "npm run build && node tools/music-check.mjs",
    "check:run": "esbuild tools/run-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/run-check/run-check.mjs --log-level=warning && node node_modules/.cache/run-check/run-check.mjs",
    "check:path": "esbuild tools/path-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/path-check/path-check.mjs --log-level=warning && node node_modules/.cache/path-check/path-check.mjs",
    "check:pathui": "npm run build && node tools/path-ui-check.mjs",
    "units:prepare": "esbuild tools/units/prepare.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/units/prepare.mjs --log-level=warning && node node_modules/.cache/units/prepare.mjs",
    "units:fixture": "esbuild tools/units/fixture.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/units/fixture.mjs --log-level=warning && node node_modules/.cache/units/fixture.mjs",
    "units:test": "npm run -s units:fixture -- /tmp/units-raw && npm run -s units:prepare -- --in /tmp/units-raw --out /tmp/units-out && echo '{\"shadowblade\":{\"hueKey\":false}}' > /tmp/units-noopts.json && npm run -s units:prepare -- --in /tmp/units-raw --out /tmp/units-noflip --options /tmp/units-noopts.json && node tools/units/check-units.mjs /tmp/units-out /tmp/units-noflip && UNITS_DIR=/tmp/units-out npm run -s sprites -- --painted",
    "fx:prepare": "node tools/fx/prepare.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "playwright-core": "1.65.0",
    "sharp": "0.35.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "2.0.0"
  },
  "dependencies": {
    "toneweft": "github:Old-GenS/toneweft#a1d147d5da6a108612dd077a66fd0775448fe070"
  }
}
